# Copy to `.env` at the repository root. Both apps read this single file:
#   - the API via `bun --env-file=../../.env`
#   - the web app via Vite `envDir` (only VITE_-prefixed vars reach the browser)

NODE_ENV=development

# API server port. The Vite dev server proxies /api and /ws to this port.
API_PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/typing_race_royale
